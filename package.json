{
  "name": "@wppopen/components-library-react",
  "description": "React bindings for components-library",
  "version": "3.3.1",

  "scripts": {
    "clean": "rimraf lib node_modules",

    "build": "tsc --project tsconfig.lib.json",
    "build-watch": "tsc-watch --project tsconfig.lib.json --preserveWatchOutput --onSuccess \"npm run yalc-push\"",

    "prebuild": "npm run build --workspace @wppopen/components-library",

    "yalc-push": "dotenv-extended --path=../../.env validEnv RUN_YALC && yalc push"
  },

  "files": [
    "lib"
  ],

  "main": "lib/index.js",

  "peerDependencies": {
    "@wppopen/components-library": "3.3.1",

    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },

  "dependencies": {
    "tslib": "2.4.0"
  },

  "devDependencies": {
    "@types/react-dom": "*",
    "typescript": "*",
    "tsc-watch": "^6.0.4"
  },

  "publishConfig": {
    "registry": "https://github.com/WPP-Public/wpp--os--platform-ui-kit-react"
  },
  "repository": "https://github.com/WPP-Public/wpp--os--platform-ui-kit-react"
}
